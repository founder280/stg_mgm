# docker compose configuration. Copy to .env and fill in before deploying.
POSTGRES_PASSWORD=change-me

# openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Origins allowed to call the API — the console and the field app.
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

ANALYTICS_INTERVAL_MINUTES=10
SYNC_STALE_MINUTES=60
